# deterministic-scripts configuration.
# Copy to ~/.config/deterministic-scripts/config.env (chmod 600) on macOS/Linux,
# or %APPDATA%\deterministic-scripts\config.env on Windows. Never commit a filled-in copy.
#
# Lookup order for the file path (homecfg.py):
#   1. --file PATH on the homecfg.py command line
#   2. $DETERMINISTIC_SCRIPTS_CONFIG (file path)
#   3. $DETERMINISTIC_SCRIPTS_HOME/config.env (folder path)
#   4. ${XDG_CONFIG_HOME:-~/.config}/deterministic-scripts/config.env (or %APPDATA%\...)
#
# Keys are lowercase snake_case, named for what they hold, not the script that reads them.
# Values >= 6 chars (other than pattern_* keys) are automatically treated as sensitive literals
# that scan_sensitive.py blocks from appearing anywhere in repos.

# --- example developer / machine keys ----------------------------------------
# dev_name="A. Developer"
# dev_email="dev@example.com"
# device_serial="XXXXXXXX"
# signing_sha1="0000000000000000000000000000000000000000"

# --- paths to secrets (hold the path, never the secret itself) ---------------
# credentials_dir="~/.secrets/app"

# --- extra scan patterns (for scan_sensitive.py) -----------------------------
# Any key starting with "pattern" is compiled as a regex by scan_sensitive.py.
# pattern_ticket="\bPRJ-\d{4}\b"

# --- shell environment overrides (set in shell profile, not in config.env) ---
# DETERMINISTIC_SCRIPTS_CONFIG=""         # override config.env path
# DETERMINISTIC_SCRIPTS_HOME=""           # override folder holding config.env and patterns.txt
# DETERMINISTIC_SCRIPTS_PATTERNS=""       # newline-separated REGEX or NAME :: REGEX
# DETERMINISTIC_SCRIPTS_LITERALS=""       # comma-separated literal values to block
# DETERMINISTIC_SCRIPTS_PATTERNS_FILE=""  # :-separated (or ;-separated on Windows) pattern files
