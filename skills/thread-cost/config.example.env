# thread-cost configuration.
# Copy to ~/.config/thread-cost/config.env on macOS/Linux, or %APPDATA%\thread-cost\config.env
# on Windows. Override the file path with THREAD_COST_CONFIG. Never commit a filled-in copy.
#
# Lookup order for every knob: environment variable (uppercase) -> this file (lowercase) -> default.
# All keys are optional; with no config file, the built-in defaults apply.

# --- cost alerts and capture thresholds (USD) --------------------------------
# THREAD_COST_ALERT_THRESHOLD / thread_cost_alert_usd: first cost alert ($5)
# thread_cost_alert_usd=5
# THREAD_COST_ALERT_STEP / thread_cost_alert_step_usd: repeat every $5
# thread_cost_alert_step_usd=5
# THREAD_COST_CAPTURE_AT / thread_cost_capture_usd: first cost-based capture block ($15)
# thread_cost_capture_usd=15
# THREAD_COST_CAPTURE_STEP / thread_cost_capture_step_usd: repeat capture every $15
# thread_cost_capture_step_usd=15

# --- live context thresholds (K tokens) --------------------------------------
# THREAD_CTX_WARN_K / thread_ctx_warn_k: on-screen context warning at Stop (200K)
# thread_ctx_warn_k=200
# THREAD_CTX_CAPTURE_K / thread_ctx_capture_k: absolute context capture backstop (300K)
# thread_ctx_capture_k=300
# THREAD_CTX_STEP_K / thread_ctx_step_k: repeat absolute context capture every 100K
# thread_ctx_step_k=100
# THREAD_CTX_GROWTH_K / thread_ctx_growth_k: capture every +40K over session baseline (0 = off)
# thread_ctx_growth_k=40

# --- prompt cache and idle wake ----------------------------------------------
# THREAD_CACHE_TTL_MIN / thread_cache_ttl_min: override model's cache_ttl_min from model_prices.json
# thread_cache_ttl_min=60
# THREAD_IDLE_MIN_CTX_K / thread_idle_min_ctx_k: minimum live context (K) for cold-cache resume note
# thread_idle_min_ctx_k=100
# THREAD_IDLE_CAPTURE_MIN / thread_idle_capture_min: idle minutes before asyncRewake capture (50)
# thread_idle_capture_min=50
# THREAD_IDLE_CAPTURE_MIN_COST / thread_idle_capture_min_cost: minimum USD cost for idle wake ($1)
# thread_idle_capture_min_cost=1
# THREAD_IDLE_CAPTURE_MIN_CTX_K / thread_idle_capture_min_ctx_k: minimum context (K) for idle wake (60K)
# thread_idle_capture_min_ctx_k=60

# --- per-turn cost line and capture step -------------------------------------
# THREAD_TURN_COST_LINE / thread_turn_cost_line: 1 = show _Last turn ~$..._, 0 = off
# thread_turn_cost_line=1
# THREAD_CAPTURE_STEP / thread_capture_step: one-line override for how the model writes a handoff
# thread_capture_step=""
# THREAD_CAPTURE_STEP_FILE / thread_capture_step_file: UTF-8 file holding the capture-step text
# thread_capture_step_file="~/path/to/capture-step.txt"

# --- state and ledger directories --------------------------------------------
# THREAD_HOOKS_STATE_DIR / thread_hooks_state_dir: hook state root
# Default: ${XDG_STATE_HOME:-~/.local/state}/thread-hooks (or %LOCALAPPDATA%\thread-hooks)
# thread_hooks_state_dir=""
# THREAD_USAGE_LEDGER_DIR / thread_usage_ledger_dir: snapshot ledger dir (default: <state root>/usage-ledger)
# thread_usage_ledger_dir=""
# THREAD_USAGE_DOCS_ROOT / thread_usage_docs_root: root for relative --doc paths (default: git top level)
# thread_usage_docs_root=""

# --- environment-only knobs (set in shell environment, not config.env) --------
# THREAD_COST_CONFIG=""               # override path to this config.env file
# THREAD_IDLE_CAPTURE_POLL_SECONDS=60 # poll interval (seconds) for thread_idle_capture.py wait
# THREAD_USAGE_NO_LIVE=1              # skip live Antigravity local-server query in thread_usage.py
