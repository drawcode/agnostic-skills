# video-trim configuration.
# Copy to ~/.config/video-trim/config.env on macOS/Linux (or set as environment variables).
# Environment variables take precedence over config.env. Never commit a filled-in copy.
# All keys are optional; with no config file, built-in defaults apply.

# --- app window cropping -----------------------------------------------------
# Default crop mode for trim.py and cut_windows.py:
#   auto = detect and crop to the app's own rectangle (phone-only captures stay uncropped)
#   off  = keep the full frame by default (--crop W:H:X:Y still overrides per call)
# VIDEO_TRIM_CROP="auto"

# --- OCR helper cache (scrub_overlays.py) ------------------------------------
# Folder for the compiled macOS Vision OCR helper binary (env var; default:
# ${XDG_CACHE_HOME:-~/.cache}/video-trim on macOS/Linux, or %LOCALAPPDATA%\video-trim on Windows).
# VIDEO_TRIM_CACHE=""
