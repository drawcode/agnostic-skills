# device-testing configuration. Copy to ~/.config/device-testing/config.env and edit.
# Override the location with DEVICE_TESTING_CONFIG. Never commit a filled-in copy.
# A project add-on can instead point the base at its own config and key names; see
# references/extending.md.

# --- devices -----------------------------------------------------------------
# One per device; the alias is uppercased to build the key. On iOS the serial is the UDID
# (`device devices` lists it).
# DEVICE_<ALIAS>_SERIAL=""
# DEVICE_<ALIAS>_NAV_PROFILE=""     # only when that device needs its own screen map
DEVICE_DEFAULT=""
DEVICE_NAV_PROFILE=""
DEVICE_LOGCAT_BUFFER="32M"
# iOS syslog collector arguments; the default drops DEBUG, which is mostly system frameworks.
DEVICE_IOS_SYSLOG_ARGS="--no-debug"

# --- app ---------------------------------------------------------------------
APP_ANDROID_PACKAGE=""
APP_IOS_BUNDLE_ID=""
# The file inside a build that `build-symbol` greps for a symbol (glob allowed for the IPA).
APP_ANDROID_SYMBOL_FILE=""
APP_IOS_SYMBOL_FILE=""
# Preferences file for `prefs`; {package} / {bundle} are filled in.
APP_ANDROID_PREFS_FILE=""
APP_IOS_PREFS_FILE=""

# --- the app's input server (references/input-server.md) ---------------------
INPUT_SERVER_PORT="11010"
INPUT_SERVER_ENV_VAR=""            # iOS launch environment variable that turns it on
INPUT_SERVER_INTENT_EXTRA=""       # Android string extra that turns it on

# --- iOS input route ----------------------------------------------------------
# auto = hid on iOS 27+, else server; hid = host-side CoreDevice touch, typing and video;
# server = the app's input server. WebDriverAgent is never a route, only opt-in commands.
DEVICE_IOS_INPUT="auto"
# Opt-in WebDriverAgent (`native`, `alert`; references/ios.md). Only `native build` needs these.
# DEVICE_IOS_WDA_SRC=""             # a WebDriverAgent checkout
# DEVICE_IOS_WDA_TEAM=""            # Apple developer team id that signs the runner
# DEVICE_IOS_WDA_BUNDLE_PREFIX=""   # unique reverse-DNS prefix, e.g. com.example.wda; `check` also reads it
#                                   # to print when the runner's profile expires
# DEVICE_IOS_WDA_PORT="8100"        # Mac-side port of the usbmux forward
# iOS record: auto = capture, then stream on the hid route, then shots; capture = USB screen
# capture at full rate (needs Camera access for the terminal's app); stream = CoreDevice video
# (iOS 27); shots = ~5 fps screenshots.
DEVICE_IOS_RECORD="auto"

# --- screenshots --------------------------------------------------------------
# `shot` also writes a downscaled copy (<name>_s.png, no taller than this many pixels) and prints its
# path first, so the cheap file is the one an agent reads. The full-size file is always kept.
# 0 = full size only. `shot --max-height N` overrides per call.
SHOT_MAX_HEIGHT="1000"

# --- quiet --------------------------------------------------------------------
# 1 = `preflight` and `record start` fail, instead of warning, when notifications are not silenced
# (`quiet status`). Android is silenced automatically; iOS needs `quiet on --confirmed` after the
# manual steps.
# DEVICE_QUIET_REQUIRED="1"

# --- tools and scratch -------------------------------------------------------
# pymobiledevice3 CLI; default ~/.venvs/pymobiledevice3/bin/pymobiledevice3, else the one on PATH.
# PYMOBILEDEVICE3=""
# Default: <system temp dir>/device-testing-scratch (shots, video, logs, the compiled iOS recorder).
# SCRATCH_ROOT=""
# ':'-separated add-on modules, each defining register(api).
DEVICE_TESTING_ADDONS=""
